# Autenticación y firma de sesiones (solo servidor)
APP_ID=
APP_SECRET=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=

# Valores públicos de OAuth incluidos en el bundle del navegador
VITE_APP_ID=
VITE_KIMI_AUTH_URL=

# MySQL persistente y accesible desde Vercel (solo servidor)
DATABASE_URL=

# Pasarela de IA compatible con OpenAI (solo servidor)
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=

# Vercel Blob privado (solo servidor)
# Obligatorio para desarrollo local o si no se usan las credenciales OIDC de Vercel.
BLOB_READ_WRITE_TOKEN=

# Solo para ejecutar el servidor Node local en modo producción
