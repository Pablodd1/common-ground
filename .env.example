# Copia este archivo a .env.local y revisa con:  npm run check:env
# En Vercel: Settings → Environment Variables. Usa valores DISTINTOS para
# Production y Preview (otra base de datos y otro Blob) para no mezclar datos reales.

# --- Autenticación y firma de sesiones (solo servidor) ---
APP_ID=
# Firma las cookies de sesión (válidas 1 año). Mínimo 32 caracteres aleatorios:
#   openssl rand -base64 48
# Cambiarlo cierra la sesión de todo el personal.
APP_SECRET=
# Sin "/" al final.
KIMI_AUTH_URL=
KIMI_OPEN_URL=
# unionId de Kimi de quien será administrador. Configúralo ANTES de su primer login.
OWNER_UNION_ID=

# --- Valores públicos (se incluyen en el JavaScript del navegador; nunca secretos) ---
# Deben ser idénticos a APP_ID y KIMI_AUTH_URL. Si cambian, hay que volver a desplegar.
VITE_APP_ID=
VITE_KIMI_AUTH_URL=

# --- MySQL persistente y accesible desde Vercel (solo servidor) ---
# mysql://usuario:clave@host:3306/base   — usa un usuario solo para esta app,
# con backups activos y TLS si tu proveedor lo exige.
DATABASE_URL=

# --- Pasarela de IA compatible con OpenAI (solo servidor; puede generar costos) ---
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=

# --- Vercel Blob privado (solo servidor) ---
# Obligatorio para desarrollo local o si no se usan las credenciales OIDC de Vercel.
BLOB_READ_WRITE_TOKEN=

# --- Solo para pruebas de integración locales (la base se BORRA; debe terminar en _test) ---
# TEST_DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/unitec_test

# --- Solo para ejecutar el servidor Node local en modo producción ---
# NODE_ENV=production
# PORT=3000
