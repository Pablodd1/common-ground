# Copia este archivo a .env.local y revisa con:  npm run check:env
# En Vercel: Settings → Environment Variables. Usa un proyecto de Supabase distinto
# para Preview si no quieres mezclar datos de prueba con datos reales del personal.

# --- Supabase: base de datos (solo servidor) ---
# Supabase → Connect → "Transaction pooler" (puerto 6543). Es la que necesita Vercel.
# postgresql://postgres.<ref>:<clave>@aws-0-<región>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Opcional, solo para `npm run db:migrate`: "Session pooler" (puerto 5432).
# DIRECT_DATABASE_URL=
# Opcional: certificado de Supabase (Settings → Database → SSL) para verificar el servidor.
# DATABASE_SSL_CA=

# --- Supabase: Auth y Storage ---
# Supabase → Project Settings → API Keys
SUPABASE_URL=
# Clave SECRETA (sb_secret_…). Solo servidor; nunca con prefijo VITE_.
# (La service_role heredada también funciona como SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=
# Bucket privado de fotos y notas de voz (lo crea `npm run setup:supabase`).
SUPABASE_STORAGE_BUCKET=media

# --- Valores públicos (van en el JavaScript del navegador) ---
VITE_SUPABASE_URL=
# Clave PÚBLICA (sb_publishable_…). Es segura en el navegador: las tablas tienen RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Acceso ---
# Dominios de correo que pueden entrar, separados por comas, sin @.  Ej.: unitec.com,unitecusa.co
ALLOWED_EMAIL_DOMAINS=
# Correo(s) que reciben el rol de administrador al entrar. Ej.: tu@unitec.com
OWNER_EMAIL=

# --- DeepSeek (asistente de la empresa; solo servidor; genera costos) ---
DEEPSEEK_API_KEY=
# Opcionales:
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Solo para pruebas locales (la base se BORRA; el nombre debe terminar en _test) ---
# TEST_DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/unitec_test
