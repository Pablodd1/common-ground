# Firma de sesiones (solo servidor). Genera un valor aleatorio largo, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Postgres de Supabase. En producción usa el pooler de transacciones (puerto
# 6543); para migraciones locales funciona la conexión directa (5432).
DATABASE_URL=

# URL del proyecto Supabase (misma variable que usa el cliente, pero aquí la
# lee el servidor para Auth y Storage)
VITE_SUPABASE_URL=

# Llave secreta de Supabase (solo servidor; jamás en el navegador)
SUPABASE_SECRET_KEY=

# Bucket privado de Supabase Storage para fotos y notas de voz
SUPABASE_STORAGE_BUCKET=media

# Dominios de correo autorizados para crear cuenta e iniciar sesión,
# separados por comas
ALLOWED_EMAIL_DOMAINS=unitecusadesign.com

# El titular de este correo recibe rol de administrador en su primer ingreso
OWNER_EMAIL=

# Pasarela de IA compatible con OpenAI (DeepSeek por defecto)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
